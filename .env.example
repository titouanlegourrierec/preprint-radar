# Copy to .env (git-ignored) and adapt. Read by the Makefile, as Make syntax: no quotes
# (they would be part of the value).

# E-mail address or URL sent to arXiv in the User-Agent, so they can reach you if the
# crawler misbehaves. On GitHub, set it as a repository variable instead.
PREPRINT_RADAR_CONTACT=you@example.org

# Optional Semantic Scholar API key (free, on request), for the citation archive: with it,
# citation counts take minutes instead of hours. The Makefile gives it to `make archive`,
# `citations` and `scholar` only. On GitHub, set it as a repository secret.
SEMANTIC_SCHOLAR_API_KEY=

# A GitHub token, for the stars of the code papers link (`make code`): any token, even one
# without any permission, since it reads public data only. The Makefile gives it to `make
# code` only; on GitHub, the workflow's own token is used.
GITHUB_TOKEN=
