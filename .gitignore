# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local experiments: scripts, raw data and results, kept out of the repository
experiments/

# arXiv catalog harvested through OAI-PMH (rebuilt, or restored from the CI cache)
.cache/

# OS
.DS_Store

# Left by a write that was interrupted (the store writes atomically, through a .tmp file)
*.tmp

# Local configuration (see .env.example)
.env

# Personal Claude Code settings (the shared launch config is committed)
.claude/settings.local.json

# The files only the weekly archive rewrites live on the data branch (SCALE-8), checked out
# in .data-branch/ and copied into data/ (.github/scripts/data-branch.sh, whose list this is)
/.data-branch/
/data/*/archive/
/data/*/top-recent.json
/data/*/scholar.json
/data/*/citation-gains.json
/data/*/topics.json
/data/*/trends.json
/data/*/cohorts.json
